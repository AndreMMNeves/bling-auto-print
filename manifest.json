{
  "manifest_version": 3,
  "name": "Onix HOF - Auto Impressão Bling",
  "version": "1.0.0",
  "description": "Imprime automaticamente o pedido quando ele é movido para Atendido no Bling.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.bling.com.br/*",
    "https://bling.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bling.com.br/*",
        "https://bling.com.br/*"
      ],
      "exclude_matches": [
        "https://www.bling.com.br/relatorios/venda.impressao.php*",
        "https://bling.com.br/relatorios/venda.impressao.php*"
      ],
      "js": ["content_listing.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bling.com.br/relatorios/venda.impressao.php*",
        "https://bling.com.br/relatorios/venda.impressao.php*"
      ],
      "js": ["content_print.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Onix HOF - Auto Impressão Bling",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
